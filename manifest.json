{
  "name": "MCHS Schedule",
  "description": "View the schedule for MCHS",
  "version": "1.1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Click to view schedule",
    "default_popup": "index.html"
  },
  "permissions": [
   "storage"
 ]
}
